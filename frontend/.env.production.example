# === Photonic Omega Facilities System - PRODUCTION ===
# Reference values for the production frontend build.
# Set these in the Vercel dashboard for the PRODUCTION environment
# (Project Settings > Environment Variables). Do NOT commit real values.
#
# Vite embeds VITE_* variables at build time - a new build is required
# after any change.
#
# Replace YOUR-DOMAIN.com with the real custom domain once configured.

VITE_API_BASE_URL=https://api.YOUR-DOMAIN.com/api/v1

# Public Supabase configuration (publishable anon key is safe in the browser).
VITE_SUPABASE_URL=https://dunijfrvfozwlykpkfhy.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
