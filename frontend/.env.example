# === Photonic Omega Facilities System ===
# Environment variable configuration for Vercel deployment.
# Copy this file to `.env.production` or set these values
# in the Vercel dashboard under Project Settings > Environment Variables.

# Backend API base URL (your deployed Spring Boot backend).
# Example: https://your-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://your-backend-host.com/api/v1

# WebSocket base URL for STOMP real-time sync.
# Example: https://your-backend.onrender.com
VITE_WS_BASE_URL=https://your-backend-host.com
