# === Photonic Omega Facilities System ===
# Frontend environment configuration.
#
# Vite embeds VITE_* variables into the bundle at BUILD time. Changing them
# requires a new production build. Never put backend secrets here - the
# frontend may only contain public configuration.
#
# Copy the relevant block into your target environment:

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
#   File: .env  (dev only, gitignored)
#   The Vite dev server proxies /api, /v1 and /ws-endpoint to the local
#   Spring Boot backend on http://localhost:8080 (see vite.config.ts).
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=
VITE_SUPABASE_URL=https://dunijfrvfozwlykpkfhy.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# VERCEL / STAGING
#   Set these in the Vercel dashboard: Project Settings > Environment
#   Variables > Preview/Development (and Production for staging builds).
#   Replace API-TEST-DOMAIN with the test backend's public origin.
#   The backend for this build runs as a SEPARATE always-on service - it is
#   never deployed to Vercel.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://API-TEST-DOMAIN/api/v1
VITE_WS_BASE_URL=https://API-TEST-DOMAIN
VITE_SUPABASE_URL=https://dunijfrvfozwlykpkfhy.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# PRODUCTION
#   Set these in the Vercel dashboard for the production environment.
#   Replace example.com with the real custom domain once configured.
#   Backend: https://api.example.com (always-on Spring Boot service)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_WS_BASE_URL=https://api.example.com
VITE_SUPABASE_URL=https://dunijfrvfozwlykpkfhy.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...