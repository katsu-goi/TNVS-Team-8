# Local H2 database files created by running the backend. Runtime state, not source.
#
# The trailing glob matters. Taking a copy of the dev database before a schema
# migration is the ordinary careful thing to do, and it lands as a sibling
# directory - backend/data.stale-190554, backend/data.fresh-verified. Those were
# invisible to `backend/data/` and showed up as untracked files ready to be
# committed, which is how a several-megabyte H2 file with real local data gets
# pushed by accident. Widened so any such copy is ignored by default and the
# backup can simply be left on disk.
backend/data*/

# Diagnostic/progress output. Regenerated on demand; never reviewed as source.
.diag/

# NOTE: these five are Java *source* files, ignored on origin/main. Kept as-is so the
# merge does not silently reverse a deliberate decision, but ignoring source is worth
# a second look - if they are untracked as well as ignored, the backend will not
# compile from a fresh clone.
backend/src/main/java/com/photonicomega/facilities/module/ai/domain/AiHealthStatus.java
backend/src/main/java/com/photonicomega/facilities/module/ai/domain/AiHumanOutcome.java
backend/src/main/java/com/photonicomega/facilities/module/ai/domain/AiProviderStatus.java
backend/src/main/java/com/photonicomega/facilities/module/ai/domain/AiProviderType.java
backend/src/main/java/com/photonicomega/facilities/module/ai/domain/AiRequestStatus.java

.vercel
.env*
